@model IEnumerable<BiblioFinder.Web.ViewModels.HistoryViewModel>

@{
    ViewData["Title"] = "Historial de Búsquedas";
}

<div class="container py-5">
    <header class="mb-5 text-center">
        <h1 class="display-5 fw-bold">Historial de Búsquedas</h1>
        <p class="lead text-muted">Aquí puedes ver todas las búsquedas realizadas.</p>
    </header>

    @if (Model.Any())
    {
        <div class="d-flex justify-content-center mb-4">
            <a asp-controller="Books" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-plus-lg me-2"></i>Nueva Búsqueda
            </a>
        </div>
        <div class="table-responsive rounded shadow-sm">
            <table id="historyTable" class="table-striped table-hover table-bordered mb-0 table">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Autor Buscado</th>
                        <th scope="col">Fecha de Consulta</th>
                        <th scope="col">Título del Libro</th>
                        <th scope="col">Año de publicación</th>
                        <th scope="col">Editorial(es)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model)
                    {
                        <tr>
                            <td>@record.Author</td>
                            <td>@record.QueryDate</td>
                            <td>@record.Title</td>
                            <td>@record.PublicationYear</td>
                            <td>@record.Publisher</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    } else
    {
        <div class="bg-light rounded border p-5 text-center">
            <i class="bi bi-clock-history" style="font-size: 3rem;"></i>
            <h4 class="mt-3">El historial está vacío</h4>
            <p class="text-muted">Aún no se ha realizado ninguna búsqueda. ¡Empieza a buscar ahora!</p>
            <a asp-controller="Books" asp-action="Index" class="btn btn-primary mt-3">
                <i class="bi bi-search me-2"></i>Ir a la Búsqueda
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#historyTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                },
                order: [[1, 'desc']]
            });
        });
    </script>
}