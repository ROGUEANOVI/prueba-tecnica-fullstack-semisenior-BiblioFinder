@{
    ViewData["Title"] = "Bienvenido a BiblioFinder";
}

<section class="bg-light py-5 text-center">
    <div class="container">
        <h1 class="display-4 fw-bold">Tu portal al universo literario</h1>
        <p class="lead text-muted my-4">
            Explora millones de títulos y autores con nuestra potente herramienta de búsqueda.
        </p>
        <a asp-controller="Books" asp-action="Index" class="btn btn-primary btn-lg">
            <i class="bi bi-search me-2"></i>Empezar a Buscar
        </a>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="card h-100 p-4 shadow-sm">
                    <div class="feature-icon-container mb-3">
                        <i class="bi bi-search"></i>
                    </div>
                    <h3 class="h4">Búsqueda Poderosa</h3>
                    <p class="text-muted">
                        Encuentra una lista completa de las obras de cualquier autor en segundos.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 p-4 shadow-sm">
                    <div class="feature-icon-container mb-3">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <h3 class="h4">Historial a tu Alcance</h3>
                    <p class="text-muted">
                        Guardamos tus búsquedas para que puedas consultarlas cómodamente cuando quieras.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 p-4 shadow-sm">
                    <div class="feature-icon-container mb-3">
                        <i class="bi bi-cloud-check"></i>
                    </div>
                    <h3 class="h4">Datos Confiables</h3>
                    <p class="text-muted">
                        Utilizamos la API de Open Library, una de las mayores bases de datos de libros del mundo.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>